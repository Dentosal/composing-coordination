[Unit]
Description=Band coordination game
After=network.target

[Service]
User=bandgame
Group=bandgame
WorkingDirectory=/opt/bandgame
ExecStart=/opt/bandgame/bin/band-game
Environment=BIND=127.0.0.1
Environment=PORT=3055
Environment=CLIENT_DIR=/opt/bandgame/client
# /api/version runs git in the checkout, which is owned by root.
Environment=GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0=*
Restart=on-failure
RestartSec=5

# Sandboxing: the server only reads its files and talks over the loopback.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

# A small shared machine: under pressure this service is the one that gets killed, not the neighbours.
MemoryHigh=200M
MemoryMax=280M
MemorySwapMax=0
OOMScoreAdjust=500
CPUQuota=90%
Nice=10

[Install]
WantedBy=multi-user.target
